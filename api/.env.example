# Banco: PostgreSQL local (serviço do Windows). Crie o banco antes:
#   psql -U postgres -c "CREATE DATABASE mercado"
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/mercado?schema=public"

# JWT — troque os segredos em produção!
# O access é curto de propósito; o refresh é longo porque o app é usado poucas
# vezes por mês e não pode exigir login novo a cada compra.
JWT_ACCESS_SECRET="troque-em-producao-access"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="troque-em-producao-refresh"
JWT_REFRESH_TTL="60d"

PORT=3010

# "dev" libera qualquer porta de localhost (flutter run usa porta variável).
# Em produção, coloque a origem exata do front.
CORS_ORIGIN="dev"

# Em produção a própria API serve o build do Flutter Web.
SERVE_WEB="false"
# WEB_DIR="C:\mercado\web\build\web"

# Catálogo externo. A cobertura do Open Food Facts para EAN brasileiro é baixa
# fora das grandes marcas — por isso ele é o segundo degrau da cascata, nunca
# o primeiro. Deixe vazio para desligar a consulta externa.
OPEN_FOOD_FACTS_URL="https://world.openfoodfacts.org/api/v2/product"
CATALOGO_EXTERNO_TIMEOUT_MS=3500

# Etiqueta de balança: EAN-13 iniciado em 2 é código interno da loja.
# PRECO  = os 6 dígitos antes do verificador são o preço em centavos
# PESO   = os 6 dígitos antes do verificador são o peso em gramas
BALANCA_FORMATO="PRECO"
